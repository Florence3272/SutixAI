<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sutix.system.mapper.UserMapper">

    <!-- 基础字段 -->
    <sql id="Base_Column_List">
        id, username, password, nickname, phone, email, role, status, create_time, update_time, deleted
    </sql>

    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" parameterType="String" resultType="com.sutix.system.entity.User">
        select <include refid="Base_Column_List"/>
        from sys_user
        where username = #{username} and deleted = 0
    </select>

</mapper>