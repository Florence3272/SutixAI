<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sutix.system.mapper.SysUserMapper">
    <select id="selectByUsername" resultType="com.sutix.system.entity.SysUser">
        SELECT u.*, r.id as role_id, r.role_name, r.role_key
        FROM sys_user u
                 LEFT JOIN sys_role r ON u.role_id = r.id
        WHERE u.username = #{username}
    </select>

    <!-- 定义结果映射 -->
    <resultMap id="UserWithRoleResultMap" type="com.sutix.system.entity.SysUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="phone" property="phone"/>
        <result column="roleId" property="roleId"/>
        <result column="status" property="status"/>
        <result column="createTime" property="createTime"/>
        <result column="updateTime" property="updateTime"/>

        <!-- 关联SysRole对象 -->
        <association property="role" javaType="com.sutix.system.entity.SysRole">
            <id column="role_id" property="id"/>
            <result column="role_name" property="roleName"/>
            <result column="role_code" property="roleCode"/>
            <result column="role_status" property="status"/>
        </association>
    </resultMap>
    <!-- 关联查询SQL -->
    <select id="selectUserWithRole" resultMap="UserWithRoleResultMap">
        SELECT u.*, r.id as role_id, r.role_name, r.role_code, r.status as role_status
        FROM sys_user u
                 LEFT JOIN sys_role r ON u.role_id = r.id
        WHERE u.id = #{userId}
    </select>
</mapper>